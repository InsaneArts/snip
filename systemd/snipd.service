[Unit]
Description=Snip screenshot daemon
Documentation=https://github.com/tornikegomareli/snip
PartOf=graphical-session.target
After=graphical-session.target
Requisite=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/snipd
Restart=on-failure
RestartSec=1
# Screenshots are private: keep them out of core dumps entirely.
LimitCORE=0

[Install]
WantedBy=graphical-session.target
