# Maintainer: Snip contributors
# S13 check: the Rust core + cxx-qt + Corrosion + Qt build packaged the AUR way
# (all downloads in prepare(); build() runs offline).
pkgname=snip-spike-git
pkgver=r0
pkgrel=1
pkgdesc="Snip de-risking spike (throwaway): Rust core + Qt Quick overlay for Hyprland"
arch=(x86_64)
url="https://github.com/tornikegomareli/snip"
license=(GPL-3.0-or-later)
depends=(qt6-base qt6-declarative qt6-wayland layer-shell-qt kcoreaddons wayland gcc-libs glibc)
makedepends=(cargo cmake ninja corrosion git)
options=(!lto !debug)
source=("snip::git+file://${SNIP_REPO:-$HOME/Development/OpenShotX}#branch=spikes/m0"
        "cxx-qt-cmake::git+https://github.com/kdab/cxx-qt-cmake.git#tag=0.10.0")
sha256sums=('SKIP' 'SKIP')

pkgver() {
  cd snip
  printf "r%s.%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd snip/spikes/s01-foundation/rust
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd snip/spikes/s01-foundation
  export RUSTUP_TOOLCHAIN=stable CARGO_NET_OFFLINE=true
  cmake -B build -G Ninja \
    -DCMAKE_BUILD_TYPE=Release \
    -DFETCHCONTENT_SOURCE_DIR_CXXQT="$srcdir/cxx-qt-cmake" \
    -DFETCHCONTENT_FULLY_DISCONNECTED=ON
  cmake --build build
}

package() {
  install -Dm755 snip/spikes/s01-foundation/build/snip-spike "$pkgdir/usr/bin/snip-spike"
}
