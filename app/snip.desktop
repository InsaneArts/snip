[Desktop Entry]
Type=Application
Name=Snip
GenericName=Screenshot Tool
Comment=Screenshots with CleanShot's workflow, in Omarchy's colours
Exec=snip settings
Icon=snip
Terminal=false
Categories=Utility;
Keywords=screenshot;capture;screen;ocr;scrolling;history;
StartupNotify=false
Actions=Area;Fullscreen;Window;Scroll;Text;History;

[Desktop Action Area]
Name=Capture Area
Exec=snip area

[Desktop Action Fullscreen]
Name=Capture Fullscreen
Exec=snip fullscreen

[Desktop Action Window]
Name=Capture Window
Exec=snip window

[Desktop Action Scroll]
Name=Scrolling Capture
Exec=snip scroll

[Desktop Action Text]
Name=Capture Text
Exec=snip text

[Desktop Action History]
Name=Capture History
Exec=snip history
